#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
COMMAND=${1:-help}

case "$COMMAND" in
  ancestry)
    shift
    exec uv run "$ROOT/tools/gen_ancestry.py" "$@"
    ;;
  geography)
    node "$ROOT/tools/build-geography.mjs"
    node "$ROOT/tools/build-pr-map.mjs"
    ;;
  gate)
    uv run "$ROOT/tools/test_gen_ancestry.py"
    node "$ROOT/tools/build-geography.mjs"
    ;;
  help|-h|--help)
    cat <<'EOF'
Vazquez-Reyes family-research cockpit

Usage:
  ./gen ancestry --help
  ./gen ancestry browser start
  ./gen ancestry browser status
  ./gen ancestry search --collection N --name Given_Surname [filters]
  ./gen ancestry capture --collection N --id RECORD_ID --capture-id ID --source-ref SOURCE
  ./gen ancestry goto "search/N?name=Given_Surname" --agent ID
  ./gen ancestry cache stats
  ./gen geography
  ./gen gate

`browser start` launches a dedicated, persistent Chrome profile on localhost:
9222. Sign into Ancestry manually in that window; the cockpit never reads or
automates login credentials.
EOF
    ;;
  *)
    printf '{"command":"%s","ok":false,"error":"unknown command"}\n' "$COMMAND"
    exit 1
    ;;
esac
